[alias]
	root = rev-parse --show-toplevel
[branch]
	sort = -committerdate
[column]
	ui = auto
[commit]
	gpgsign = true
	verbose = true
[diff]
	algorithm = histogram
	renames = true
	mnemonicPrefix = true
	colorMoved = plain
[core]
	editor = vim
	excludesfile = ~/.gitignore_global
	fsmonitor = true
	untrackedCache = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	required = true
	smudge = git-lfs smudge -- %f
[github]
	user = jamesepatrick
[gpg]
	format = ssh
[include]
	path = ~/.gitconfig.local
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	followTags = true
[rebase]
	autoStash = true
	updateRefs = true
[tag]
	sort = version:refname
[user]
	name = James Patrick
	signingkey = ~/.ssh/github.com.pub
